    <dict><key>name</key><string>Link</string><key>scope</key><string>markup.underline.link</string>
      <key>settings</key><dict><key>foreground</key><string>#0451A5</string></dict></dict>
    <dict><key>name</key><string>Diff inserted</string><key>scope</key><string>markup.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>#098658</string></dict></dict>
    <dict><key>name</key><string>Diff deleted</string><key>scope</key><string>markup.deleted</string>
      <key>settings</key><dict><key>foreground</key><string>#A31515</string></dict></dict>
    <dict><key>name</key><string>Diff header</string><key>scope</key><string>meta.diff.header, meta.diff.range, meta.diff.index</string>
      <key>settings</key><dict><key>foreground</key><string>#000080</string></dict></dict>
    <dict><key>name</key><string>Invalid</string><key>scope</key><string>invalid</string>
      <key>settings</key><dict><key>foreground</key><string>#CD3131</string></dict></dict>
  </array>
</dict>
</plist>
